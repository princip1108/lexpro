LEXPRO_DB_URL=jdbc:postgresql://127.0.0.1:5432/lexpro?currentSchema=lexpro
LEXPRO_DB_USERNAME=postgres
LEXPRO_DB_PASSWORD=replace-with-local-password
# Set true only for the first start of a new empty database so Flyway applies V1-V7.
LEXPRO_FLYWAY_ENABLED=false
# Keep false for a new database. Existing legacy databases require a reviewed backup/migration plan.
LEXPRO_FLYWAY_BASELINE_ON_MIGRATE=false
LEXPRO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LEXPRO_BOOTSTRAP_ADMIN_ENABLED=false
LEXPRO_BOOTSTRAP_ADMIN_USERNAME=demo_admin
LEXPRO_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-development-password
LEXPRO_BOOTSTRAP_ADMIN_REAL_NAME=管理员
LEXPRO_BOOTSTRAP_ORGANIZATION_CODE=LEXPRO
LEXPRO_BOOTSTRAP_ORGANIZATION_NAME=LexPro
# Generate a unique value of at least 32 bytes. Never commit the real secret.
LEXPRO_JWT_SECRET=replace-with-at-least-32-random-characters
LEXPRO_JWT_ISSUER=https://lexpro.local
LEXPRO_JWT_ACCESS_TOKEN_TTL=PT30M
LEXPRO_LOGIN_RATE_LIMIT_ENABLED=true
LEXPRO_LOGIN_USERNAME_MAX_ATTEMPTS=5
LEXPRO_LOGIN_ADDRESS_MAX_ATTEMPTS=100
LEXPRO_LOGIN_RATE_LIMIT_WINDOW=PT5M
LEXPRO_LOGIN_BLOCK_DURATION=PT15M
LEXPRO_LOGIN_MAX_TRACKED_ENTRIES=10000
# LexPro_8B is exposed through an OpenAI-compatible vLLM endpoint.
LEXPRO_AI_ENABLED=true
LEXPRO_AI_BASE_URL=http://127.0.0.1:8001/v1
LEXPRO_AI_API_KEY=EMPTY
LEXPRO_AI_MODEL=LexPro_8B
# Keep false for the local/tunneled LexPro endpoint. Enable only after approving an external provider.
LEXPRO_AI_ALLOW_EXTERNAL_CASE_DATA=false
LEXPRO_AI_CONNECT_TIMEOUT=PT5S
LEXPRO_AI_READ_TIMEOUT=PT15M
LEXPRO_AI_MAX_INPUT_CHARS=60000
LEXPRO_AI_MAX_OUTPUT_TOKENS=1536
LEXPRO_AI_ENABLE_THINKING=false
# Enable only after reviewed V7 migration. Never commit the real encryption key.
LEXPRO_MODEL_CONFIG_ENABLED=false
LEXPRO_MODEL_CONFIG_MASTER_KEY=
LEXPRO_MODEL_CONFIG_ALLOWED_URLS=http://127.0.0.1:8001/v1
# Approved internal MinerU/LexPro adapter. Use the same secret on both services.
LEXPRO_AI_SERVICE_ENABLED=true
LEXPRO_AI_SERVICE_BASE_URL=http://127.0.0.1:8020
LEXPRO_AI_SERVICE_INTERNAL_TOKEN=replace-with-at-least-32-random-characters
LEXPRO_AI_SERVICE_CONNECT_TIMEOUT=PT5S
LEXPRO_AI_SERVICE_READ_TIMEOUT=PT15M
LEXPRO_AI_SERVICE_MAX_FILE_SIZE=25MB
# LOCAL keeps the existing BGE-M3 service; PARTNER uses the SSH-tunneled provider API.
LEXPRO_TYPICAL_CASE_PROVIDER=LOCAL
LEXPRO_RETRIEVAL_ENABLED=false
LEXPRO_RETRIEVAL_BASE_URL=http://127.0.0.1:8010
LEXPRO_PARTNER_TYPICAL_CASE_BASE_URL=http://127.0.0.1:8000
# Explicit deployment approval is required before real case facts can leave LexPro.
LEXPRO_PARTNER_TYPICAL_CASE_ALLOW_CASE_DATA=false
LEXPRO_PARTNER_TYPICAL_CASE_CONNECT_TIMEOUT=PT3S
LEXPRO_PARTNER_TYPICAL_CASE_ANALYZE_TIMEOUT=PT60S
LEXPRO_PARTNER_TYPICAL_CASE_SEARCH_TIMEOUT=PT30S
LEXPRO_PARTNER_TYPICAL_CASE_MAX_RESULTS=20
LEXPRO_PARTNER_TYPICAL_CASE_ANALYSIS_TTL=PT10M
# Required only for PARTNER; generate at least 32 random bytes and keep the real value out of Git.
LEXPRO_PARTNER_TYPICAL_CASE_TOKEN_SECRET=replace-with-at-least-32-random-characters
LEXPRO_MCP_ENABLED=false
LEXPRO_MCP_ENDPOINT=/mcp
LEXPRO_MCP_REQUEST_TIMEOUT=PT55S
LEXPRO_MCP_MAX_ITEMS=20
LEXPRO_MCP_MAX_OUTPUT_CHARS=50000
# Required when MCP is enabled. The file stores SHA-256 token digests, never plaintext tokens.
LEXPRO_MCP_CLIENT_REGISTRY_PATH=/absolute/path/to/mcp-client-registry.json
LEXPRO_MCP_TOKEN_RELOAD_INTERVAL=PT30S
LEXPRO_MCP_MAX_CONCURRENT_REQUESTS=8
LEXPRO_MCP_MAX_CONCURRENT_PER_CLIENT=2
LEXPRO_MCP_RATE_LIMIT_PER_MINUTE=60
